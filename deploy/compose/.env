# PostgreSQL Credentials
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=badge_db

# External Hostnames (for multi-VM deployment)
# Replace with actual IPs or resolvable DNS names in a real scenario
APP_HOST=vm1-app.local
MESSAGING_HOST=vm2-messaging.local
DATA_HOST=vm3-data.local

# Service versions
CONFLUENT_VERSION=7.5.0
POSTGRES_VERSION=15-alpine
REDIS_VERSION=7-alpine
NGINX_VERSION=alpine
MOSQUITTO_VERSION=2