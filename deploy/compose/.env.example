# Copy this file to .env and fill in your values before running docker compose.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_VERSION=15-alpine
POSTGRES_USER=entrance_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=entrance_db

# --- Redis ---
REDIS_VERSION=7-alpine

# --- Kafka / Zookeeper ---
CONFLUENT_VERSION=7.5.0
KAFKA_ACCESS_EVENTS_TOPIC=access-events

# --- Mosquitto ---
MOSQUITTO_VERSION=2

# --- NGINX ---
NGINX_VERSION=alpine
